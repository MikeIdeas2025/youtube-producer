#!/bin/bash
# Wrapper comune: yt-<cmd> → lib/<cmd con _>.py nel venv del toolkit; thumbvision → binario Swift.
#
# I comandi si chiamano per nome nudo (yt-ingest …): bin/ del plugin è nel PATH del tool Bash mentre il
# plugin è attivo e contiene symlink relativi yt-* → ../scripts/yt/bin/_run. Funzionano anche i symlink
# in scripts/yt/bin/. Il venv sta nella data dir del plugin (vedi _paths.sh e lib/config.py):
#   <data>/venv/bin/python             (layout del plugin, creato da /youtube:setup → install.sh)
#   <scripts/yt>/.venv/bin/python      (checkout di sviluppo con layout storico)
# yt-config funziona anche senza venv (python3 di sistema: config.py usa solo la stdlib).
# Forma diretta: `_run <yt-comando|thumbvision> [argomenti]` (Codex non copia i symlink del plugin: i comandi yt-* di
# Codex sono shim in <data>/shims, creati da codex-shims.sh, che chiamano questa forma).
set -euo pipefail

self="$0"
cmd="$(basename "$self")"
if [ "$cmd" = "_run" ] && [ $# -gt 0 ]; then
  case "$1" in yt-*|thumbvision) cmd="$1"; shift ;; esac
fi
src="$self"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
YT_HOME="$(cd -P "$(dirname "$src")/.." && pwd)"
# shellcheck source=_paths.sh
. "$YT_HOME/bin/_paths.sh"

data="$(yt_data_dir)"
if [ -n "$data" ]; then
  export YT_DATA="$data"
  # bytecode Python nella data dir, mai dentro il plugin (la cache dei plugin resta com'è stata installata)
  export PYTHONPYCACHEPREFIX="${PYTHONPYCACHEPREFIX:-$data/pycache}"
  py="$data/venv/bin/python"
  tv="$data/bin/thumbvision"
  [ -x "$tv" ] || tv="$YT_HOME/bin/thumbvision"
else
  py="$YT_HOME/.venv/bin/python"
  tv="$YT_HOME/bin/thumbvision"
fi

# In Codex (sessione di Codex, o toolkit nella cache dei plugin di Codex) la skill si chiama $youtube:setup
SETUP_CMD="/youtube:setup"
case "${CODEX_SESSION_ID:-}:$YT_HOME" in
  ?*:*|*/.codex/plugins/cache/*) SETUP_CMD='$youtube:setup' ;;
esac

json_error() {  # messaggio → JSON su stdout (contratto dei comandi) + testo su stderr
  local m="$1"
  m="${m//\\/\\\\}"; m="${m//\"/\\\"}"
  printf '{\n  "ok": false,\n  "error": "%s"\n}\n' "$m"
  echo "$1" >&2
}

case "$cmd" in
  thumbvision)
    if [ ! -x "$tv" ]; then
      json_error "thumbvision non disponibile ($tv): esegui $SETUP_CMD (oppure yt-install --yes)"
      exit 3
    fi
    exec "$tv" "$@"
    ;;
  yt-*) ;;
  *)
    echo "uso: invocare tramite un symlink yt-<comando> (es. yt-doctor) oppure come $cmd yt-<comando> [argomenti]" >&2
    exit 2
    ;;
esac

mod="${cmd#yt-}"; mod="${mod//-/_}"
script="$YT_HOME/lib/$mod.py"
if [ ! -f "$script" ]; then
  json_error "comando sconosciuto: $cmd (manca $script)"
  exit 2
fi

if [ ! -x "$py" ]; then
  if [ "$mod" = "config" ]; then
    sys_py=/usr/bin/python3
    [ -x "$sys_py" ] || sys_py="$(command -v python3 || true)"
    if [ -n "$sys_py" ]; then
      exec "$sys_py" -I -B "$script" "$@"
    fi
  fi
  json_error "Toolkit non installato: manca il venv Python ($py). Esegui $SETUP_CMD (oppure yt-install --yes)."
  exit 3
fi
exec "$py" "$script" "$@"
